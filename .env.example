# Copy to .env (or set in Vercel → Project Settings → Environment Variables) to connect the enquiry forms.
# Both forms POST JSON to this URL. Validate everything again on the server; browser checks are only a convenience.
#
# type "workforce-enquiry" (Contact → full form):
#   fullName, company, email, phone, businessType, workforceType, roles, workerCount,
#   shiftPattern, location, startDate, message, consent, website, submittedAt
# type "urgent-cover" (Contact → "Need cover this week?"):
#   fullName, phone, location, requirement, website, submittedAt
#
# `website` is a spam honeypot: discard any submission where it is not empty.
VITE_ENQUIRY_ENDPOINT=

# Optional: public site URL for canonical links, share images and the sitemap.
# Defaults to Vercel's production domain when unset.
VITE_SITE_URL=
